# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3334
NEXT_PUBLIC_SITE_NAME=Laptop Club

# Used by the hosted Studio presentation tool to iframe the frontend.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3334

# Used by stega source maps to link preview overlays back to Studio.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3334/studio

# Sanity
# Use the Sanity project ID, not the project/display name.
NEXT_PUBLIC_SANITY_PROJECT_ID=zbmgwp5w
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Required for Draft Mode and Visual Editing. Use a Viewer token.
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
